        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-25" value="Rule Base&lt;div&gt;基于人给定规则&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#d79b00;dashed=1;fillColor=#ffe6cc;" parent="1" vertex="1">
          <mxGeometry x="125.53999999999999" y="160" width="86" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="6IqHjoIy6tGT8FBDFJxy-26" target="6IqHjoIy6tGT8FBDFJxy-27" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-26" value="Statistic modal&lt;div&gt;基于词频&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#d79b00;dashed=1;fillColor=#ffe6cc;" parent="1" vertex="1">
          <mxGeometry x="246.07" y="160" width="86" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="6IqHjoIy6tGT8FBDFJxy-27" target="6IqHjoIy6tGT8FBDFJxy-29" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-27" value="RNN" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#d79b00;dashed=1;fillColor=#ffe6cc;" parent="1" vertex="1">
          <mxGeometry x="360" y="160" width="86" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-28" value="1️⃣大模型为什么会使用Transformer而不是CNN&lt;div&gt;2️⃣scale up是什么&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="23.5" y="100" width="263" height="40" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-29" value="Transformer" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#d79b00;dashed=1;fillColor=#ffe6cc;" parent="1" vertex="1">
          <mxGeometry x="476.14" y="160" width="86" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-31" value="Vision" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=14;strokeColor=#d79b00;dashed=1;fillColor=#ffe6cc;" parent="1" vertex="1">
          <mxGeometry x="23.5" y="230" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-32" value="Hand-crafted feature + SVN&lt;div&gt;人为定义特征（点，线，圆，角） + 机器学习&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#d79b00;dashed=1;fillColor=#ffe6cc;" parent="1" vertex="1">
          <mxGeometry x="125.54" y="230" width="254.46" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-33" value="CNN" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#d79b00;dashed=1;fillColor=#ffe6cc;" parent="1" vertex="1">
          <mxGeometry x="400" y="230" width="64.46" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-34" value="Transformer&lt;div&gt;视频或图片切分为patch，这样patch类比于文字里面的token&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#d79b00;dashed=1;fillColor=#ffe6cc;" parent="1" vertex="1">
          <mxGeometry x="490" y="230" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-38" value="人们发现随着数据量和算力的提升，CNN或者RNN模型会达到一个瓶颈，但是Transformer却可以随之得到提升，没那么容易达到瓶颈" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="23.5" y="310" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-39" value="RNN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="23.5" y="380" width="50" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-40" value="CNN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="23.5" y="415" width="50" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-41" value="Transformer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="23.5" y="452.5" width="70" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-42" value="RNN和CNN的inductive bias会比较强" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#d6b656;fillColor=#fff2cc;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="81.5" y="395" width="204" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-43" value="Inductive bias：bias越高，代表模型的限定范围越明确，所需要的数据集就会越少，但也意味着自我探索，突破边界的能力下降" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;strokeColor=#82b366;dashed=1;fillColor=#d5e8d4;" parent="1" vertex="1">
          <mxGeometry x="113.5" y="437.5" width="390" height="40" as="geometry" />
        </mxCell>
        <UserObject label="https://arxiv.org/abs/2010.11929" link="https://arxiv.org/abs/2010.11929" id="6IqHjoIy6tGT8FBDFJxy-44">
          <mxCell style="text;whiteSpace=wrap;fontSize=16;fontStyle=0" parent="1" vertex="1">
            <mxGeometry x="30" y="510" width="240" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-45" value="我们看看Google Reaserch对于Transformer用于图像的报告" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="32.5" y="540" width="327.5" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6IqHjoIy6tGT8FBDFJxy-46" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
